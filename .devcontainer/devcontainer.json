{
  "name": "toon-vs-json-minikube",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "latest"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "TOON vs JSON (minikube)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash scripts/codespaces-deploy.sh",
  "remoteUser": "root"
}
